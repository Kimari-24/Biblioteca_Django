# Copia este archivo como .env y reemplaza los valores por los de tu proyecto de Firebase.

# --- Firebase: configuración web (Configuración del proyecto → General → Tus apps) ---
FIREBASE_PROJECT_ID=tu-id-de-proyecto
FIREBASE_WEB_API_KEY=tu-clave-de-api-web
FIREBASE_AUTH_DOMAIN=tu-id-de-proyecto.firebaseapp.com
FIREBASE_STORAGE_BUCKET=tu-id-de-proyecto.firebasestorage.app
FIREBASE_MESSAGING_SENDER_ID=000000000000
FIREBASE_APP_ID=1:000000000000:web:xxxxxxxxxxxxxxxx
FIREBASE_MEASUREMENT_ID=G-XXXXXXXXXX

# --- Firebase: cuenta de servicio (Configuración del proyecto → Cuentas de servicio) ---
# Opción A: ruta al archivo .json de la llave privada.
FIREBASE_CREDENTIALS_PATH=firebase/serviceAccountKey.json
# Opción B: los campos del .json como variables (tienen prioridad si FIREBASE_PRIVATE_KEY existe).
FIREBASE_PRIVATE_KEY_ID=
FIREBASE_PRIVATE_KEY=
FIREBASE_CLIENT_EMAIL=
FIREBASE_CLIENT_ID=
FIREBASE_CLIENT_CERT_URL=
